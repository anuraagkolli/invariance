# ---------------------------------------------------------------------------
# Default setup needs NO env at all: the agents run an open-source model
# (qwen2.5) through the app's /api/llm proxy, which forwards to a local Ollama.
# Just have `ollama serve` running with `ollama pull qwen2.5` done.
# Everything below is an override.
# ---------------------------------------------------------------------------

# --- Server-side (proxy upstream; never shipped to the browser) -------------

# Where the proxy forwards OpenAI-shaped requests (convention INCLUDES /v1).
# LLM_BASE_URL=http://localhost:11434/v1

# The model the proxy pins on every request, regardless of what the browser
# sends. Bump for quality (e.g. qwen2.5:14b) — no code change.
# LLM_MODEL=qwen2.5

# Bearer token for hosted OpenAI-compatible endpoints. Ollama ignores it.
# LLM_API_KEY=

# Only needed when switching the provider to Claude (see below).
# ANTHROPIC_API_KEY=

# Absolute base for OG/social-preview links on a deployed host.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# --- Client-side provider selection ------------------------------------------

# Unset = default open-source-via-proxy path.
# 'anthropic' = Claude through the same proxy (set ANTHROPIC_API_KEY above).
# 'openai-compatible' = legacy browser-direct mode (needs OLLAMA_ORIGINS=* on
#   the Ollama side; uses the NEXT_PUBLIC_LLM_* vars below).
# NEXT_PUBLIC_LLM_PROVIDER=

# Model id the agents put on the wire (proxy pins LLM_MODEL anyway; in
# browser-direct mode this is the model actually used).
# NEXT_PUBLIC_LLM_MODEL=qwen2.5

# Browser-direct mode only: the OpenAI-compatible base URL.
# NEXT_PUBLIC_LLM_BASE_URL=http://localhost:11434/v1

# Structured-output mode. 'json_schema' (default) uses native response_format
# enforcement; 'json_object' is the fallback for servers/models that reject
# json_schema (schema embedded in the prompt; zod revalidation + retry absorb
# imperfect output).
# NEXT_PUBLIC_LLM_STRUCTURED_MODE=json_schema
