# Anthropic (default provider). Used by the customization panel's agents.
NEXT_PUBLIC_ANTHROPIC_API_KEY=

# LLM provider selection. Leave unset (or 'anthropic') for the default Anthropic
# path. Set to 'openai-compatible' to run the agents against a local Ollama model
# (or any OpenAI-compatible server) for free local iteration.
# NEXT_PUBLIC_LLM_PROVIDER=openai-compatible

# OpenAI-compatible base URL (convention INCLUDES /v1). Ollama serves here.
# NEXT_PUBLIC_LLM_BASE_URL=http://localhost:11434/v1

# The single local model id; the demo fans it out to all four agent roles.
# NEXT_PUBLIC_LLM_MODEL=qwen2.5

# Structured-output mode for the openai-compatible path. 'json_schema' (default)
# uses native response_format schema enforcement; 'json_object' is the fallback
# for servers/models that reject json_schema (schema is embedded in the prompt and
# the agents' zod revalidation + retry absorb imperfect output).
# NEXT_PUBLIC_LLM_STRUCTURED_MODE=json_schema
