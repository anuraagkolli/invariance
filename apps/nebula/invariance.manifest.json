  "components": [
    {
      "id": "nav",
      "name": "Top navigation",
      "slots": [
        {
          "name": "extra",
          "overridable": true,
          "description": "Free area right of the nav links"
        }
      ]
    },
    {
      "id": "billboard",
      "name": "Featured billboard",
      "slots": [
        {
          "name": "tagline",
          "overridable": true,
          "description": "Promo line above the title"
        },
        {
          "name": "meta",
          "overridable": false,
          "description": "Year / maturity / duration line (locked)"
        }
      ]
    },
    {
      "id": "row",
      "name": "Carousel row",
      "slots": [
        {
          "name": "heading-extra",
          "overridable": true,
          "description": "Inline area right of a row heading"
        }
      ]
    },
    {
      "id": "show-card",
      "name": "Show card",
      "slots": [
        {
          "name": "badge",
          "overridable": true,
          "description": "Badge area on the poster"
        }
      ]
    },
    {
      "id": "footer",
      "name": "Footer",
      "slots": [
        {
          "name": "message",
          "overridable": true,
          "description": "Footer message line"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "list-shows",
      "method": "GET",
      "path": "/api/shows",
      "description": "Full catalog; the client groups rows by genre"
    },
    {
      "id": "featured",
      "method": "GET",
      "path": "/api/featured",
      "description": "Billboard show"
    },
    {
      "id": "continue-watching",
      "method": "GET",
      "path": "/api/continue",
      "description": "In-progress shows with percent watched"
    },
    {
      "id": "list-watchlist",
      "method": "GET",
      "path": "/api/watchlist",
      "description": "The user's list"
    },
    {
      "id": "add-watchlist",
      "method": "POST",
      "path": "/api/watchlist",
      "description": "Add a show to the list"
    },
    {
      "id": "remove-watchlist",
      "method": "DELETE",
      "path": "/api/watchlist/:id",
      "description": "Remove from the list"
    }
  ],
  "policies": [
    {
      "type": "endpoint-deny",
      "id": "no-hooking-deletes",
      "description": "Mods may never intercept list deletion",
      "endpointId": "remove-watchlist"
    },
    {
      "type": "field-constraint",
      "id": "titles-immutable",
      "description": "Show titles are canonical and may not be rewritten",
      "endpointId": "list-shows",
      "fieldPath": "shows.*.title",
      "constraint": {
        "immutable": true
      }
    },
    {
      "type": "field-constraint",
      "id": "maturity-immutable",
      "description": "Maturity ratings are a compliance surface: no mod may alter or hide them",
      "endpointId": "list-shows",
      "fieldPath": "shows.*.maturity",
      "constraint": {
        "immutable": true
      }
    },
    {
      "type": "field-constraint",
      "id": "featured-title-immutable",
      "description": "The billboard show's title is canonical",
      "endpointId": "featured",
      "fieldPath": "show.title",
      "constraint": {
        "immutable": true
      }
    },
    {
      "type": "field-constraint",
      "id": "priority-range",
      "description": "Watchlist priority stays within 1-5",
      "endpointId": "add-watchlist",
      "fieldPath": "priority",
      "constraint": {
        "min": 1,
        "max": 5
      }
    },
    {
      "type": "budget-limit",
      "id": "hook-budgets",
      "maxCpuMsPerHook": 100,
      "maxMemMbPerHook": 64
    }
  ],
  "createdAt": "2026-06-10T00:00:00.000Z",
  "designSurface": {
    "pages": [
      { "route": "/", "defaultLevel": 4 },
      { "route": "/series", "defaultLevel": 4 }
    ],
    "sections": ["hero", "row-trending", "row-continue", "row-originals", "row-new", "row-acclaimed"]
  }
}
